                {
                  "type": "markdown",
                  "content": "<ha-alert alert-type=\"info\">MISSION CONTROL ONLINE</ha-alert>\n\n**{{ now().strftime('%H:%M:%S') }}** · {{ now().strftime('%a %d %b') }}\n\n`MONA` {{ states('assist_satellite.home_assistant_voice_0aab68_assist_satellite') | upper }} · `WORKSHOP` {{ states('binary_sensor.motion_sensor_2_occupancy') | upper }} · `MIRROR` {{ states('binary_sensor.motion_sensor_1_occupancy') | upper }}",
                  "card_mod": {
                    "style": "\nha-card {\n  border-color: rgba(126, 200, 255, 0.55) !important;\n  background: linear-gradient(135deg, rgba(10,24,48,0.95), rgba(6,12,28,0.92)) !important;\n  box-shadow: 0 0 40px rgba(80,170,255,0.25), inset 0 0 40px rgba(126,200,255,0.05) !important;\n}\nha-card {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  letter-spacing: 0.04em;\n}\n"
                  }
                }
              ]
            },
