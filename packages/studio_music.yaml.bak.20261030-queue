# Package: studio_music
# “Play music” / volume on any Assist assistant -> Music Assistant on Full Studio.
# play_studio_music: exact search, vibe (AI Task -> MA search), or default playlist.

input_text:
  studio_music_last_pick:
    name: Studio Music Last Pick
    max: 255
    initial: ""

script:
  play_studio_music:
    alias: Play Studio Music
    description: >-
      Play music on Full Studio via Music Assistant. Empty or generic words use
      the default playlist. Exact names (e.g. Bonobo) search MA directly. Mood
      or situational requests (e.g. inspirational music for the morning) use AI
      to pick a short MA search, wait for results, then play. Pass vibe language
      in query; do not invent media URIs.
    fields:
      query:
        description: >-
          Song, artist, playlist, genre, or a vibe/mood description for the moment.
        example: "something chill for a rainy afternoon"
    mode: restart
    sequence:
      - variables:
          target_player: media_player.full_studio
          default_uri: "library://playlist/1"
          ma_config_id: 01K50H4V9P53VZ36HSWHBZ13WP
          q: "{{ query | default('', true) | string | trim }}"
          generic: >-
            {{ q == '' or (q | lower) in
               ['music','some music','tunes','some tunes','something','songs',
                'some songs','my music','a song','anything','some tune','tune'] }}
          is_vibe: >-
            {% set ql = q | lower %}
            {% set wc = q.split() | length %}
            {% set markers = [
              'like', 'fitting', 'fit for', 'mood', 'vibe', 'feel', 'feeling',
              'inspirational', 'inspire', 'chill', 'relax', 'calm', 'focus',
              'workout', 'energy', 'upbeat', 'morning', 'evening', 'afternoon',
              'night', 'late night', 'rainy', 'sunny', 'weather', 'time of',
              'for the', 'that is', 'that are', 'music that', 'sounds like',
              'something', 'anything', 'cozy', 'romantic', 'party', 'study',
              'creative', 'winding down', 'wake up', 'sunset', 'dinner'
            ] %}
            {% set hit = markers | select('in', ql) | list | length > 0 %}
            {{ (wc > 3 and hit) or (wc > 5) or (hit and wc > 2) }}

      - choose:
          - conditions:
              - condition: template
                value_template: "{{ generic }}"
            sequence:
              - action: music_assistant.play_media
                target:
                  entity_id: "{{ target_player }}"
                data:
                  media_id: "{{ default_uri }}"
              - action: input_text.set_value
                target:
                  entity_id: input_text.studio_music_last_pick
                data:
                  value: "default playlist"

          - conditions:
              - condition: template
                value_template: "{{ is_vibe }}"
            sequence:
              - action: ai_task.generate_data
                continue_on_error: true
                data:
                  task_name: studio music vibe pick
                  entity_id: ai_task.openai_ai_task
                  instructions: >-
                    Pick music for a home studio (Music Assistant / Spotify search).

                    User request: {{ q }}

                    Context:
                    - Local time: {{ now().strftime('%A %H:%M') }} (hour {{ now().hour }})
                    - Weather: {{ states('weather.forecast_home') }}

                    Return a SHORT search_query (1-4 words) Music Assistant can find
                    (artist, playlist title, genre, or album—not a full sentence).
                    For mood/vibe requests prefer media_type playlist or artist.
                  structure:
                    search_query:
                      description: Short Music Assistant search string
                      required: true
                      selector:
                        text:
                    media_type:
                      description: track, artist, playlist, or album
                      required: true
                      selector:
                        text:
                    announce:
                      description: One short phrase describing the pick
                      required: true
                      selector:
                        text:
                response_variable: vibe_pick
              - variables:
                  search_name: >-
                    {% if vibe_pick is defined and vibe_pick.data is defined
                       and vibe_pick.data.search_query | default('') | trim != '' %}
                      {{ vibe_pick.data.search_query | trim }}
                    {% else %}
                      {{ q }}
                    {% endif %}
                  preferred_type: >-
                    {% if vibe_pick is defined and vibe_pick.data is defined %}
                      {{ vibe_pick.data.media_type | default('playlist') | string | lower | trim }}
                    {% else %}
                      playlist
                    {% endif %}
                  pick_announce: >-
                    {% if vibe_pick is defined and vibe_pick.data is defined %}
                      {{ vibe_pick.data.announce | default('') | trim }}
                    {% else %}
                      {{ q[:80] }}
                    {% endif %}
              - action: script.play_studio_music_search_and_play
                data:
                  search_name: "{{ search_name }}"
                  preferred_type: "{{ preferred_type }}"
                  announce: "{{ pick_announce }}"

          - conditions:
              - condition: template
                value_template: "{{ not generic and not is_vibe }}"
            sequence:
              - variables:
                  search_name: "{{ q }}"
                  preferred_type: >-
                    {% set wc = q.split() | length %}
                    {{ 'artist' if wc <= 2 else 'track' }}
                  pick_announce: "{{ q }}"
              - action: script.play_studio_music_search_and_play
                data:
                  search_name: "{{ search_name }}"
                  preferred_type: "{{ preferred_type }}"
                  announce: "{{ pick_announce }}"

  play_studio_music_search_and_play:
    alias: Play Studio Music Search And Play
    description: Internal — MA search, pick URI, play on Full Studio
    mode: restart
    fields:
      search_name:
        description: Music Assistant search string
      preferred_type:
        description: playlist, track, artist, or album
      announce:
        description: Short label for last-pick helper
    sequence:
      - variables:
          target_player: media_player.full_studio
          default_uri: "library://playlist/1"
          ma_config_id: 01K50H4V9P53VZ36HSWHBZ13WP
          pref: "{{ preferred_type | default('playlist') | string | lower | trim }}"
      - action: music_assistant.search
        continue_on_error: true
        data:
          config_entry_id: "{{ ma_config_id }}"
          name: "{{ search_name }}"
          media_type: ["playlist", "artist", "track", "album"]
        response_variable: ma_search
      - variables:
          chosen_uri: >-
            {% set r = ma_search if ma_search is defined else {} %}
            {% set pref = preferred_type | default('playlist') | string | lower %}
            {% set bucket_order = {
              'playlist': ['playlists', 'tracks', 'artists', 'albums'],
              'track': ['tracks', 'playlists', 'artists', 'albums'],
              'artist': ['artists', 'playlists', 'tracks', 'albums'],
              'album': ['albums', 'tracks', 'playlists', 'artists']
            } %}
            {% set order = bucket_order.get(pref, ['playlists', 'tracks', 'artists', 'albums']) %}
            {% set ns = namespace(uri='', label='') %}
            {% for pass in range(2) %}
              {% for b in order %}
                {% if ns.uri == '' %}
                  {% for item in r[b] | default([]) %}
                    {% if ns.uri == '' %}
                      {% set uri = item.uri | default('') %}
                      {% set fav = item.favorite | default(false) %}
                      {% if uri and (pass == 1 or fav or uri.startswith('library://') or loop.first) %}
                        {% set ns.uri = uri %}
                        {% set ns.label = item.name | default('') %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            {{ ns.uri }}
          chosen_label: >-
            {% set r = ma_search if ma_search is defined else {} %}
            {% set pref = preferred_type | default('playlist') | string | lower %}
            {% set bucket_order = {
              'playlist': ['playlists', 'tracks', 'artists', 'albums'],
              'track': ['tracks', 'playlists', 'artists', 'albums'],
              'artist': ['artists', 'playlists', 'tracks', 'albums'],
              'album': ['albums', 'tracks', 'playlists', 'artists']
            } %}
            {% set order = bucket_order.get(pref, ['playlists', 'tracks', 'artists', 'albums']) %}
            {% set ns = namespace(uri='', label='') %}
            {% for pass in range(2) %}
              {% for b in order %}
                {% if ns.uri == '' %}
                  {% for item in r[b] | default([]) %}
                    {% if ns.uri == '' %}
                      {% set uri = item.uri | default('') %}
                      {% set fav = item.favorite | default(false) %}
                      {% if uri and (pass == 1 or fav or uri.startswith('library://') or loop.first) %}
                        {% set ns.uri = uri %}
                        {% set ns.label = item.name | default('') %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            {{ ns.label }}
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ chosen_uri | default('') | trim != '' }}"
            sequence:
              - action: music_assistant.play_media
                target:
                  entity_id: "{{ target_player }}"
                data:
                  media_id: "{{ chosen_uri }}"
              - action: input_text.set_value
                target:
                  entity_id: input_text.studio_music_last_pick
                data:
                  value: "{{ ((announce | default('') | string | trim) ~ ': ' ~ chosen_label ~ ' (' ~ chosen_uri ~ ')')[:255] }}"
          - conditions:
              - condition: template
                value_template: "{{ chosen_uri | default('') | trim == '' }}"
            sequence:
              - action: music_assistant.search
                continue_on_error: true
                data:
                  config_entry_id: "{{ ma_config_id }}"
                  name: "{{ search_name }}"
                  media_type: ["playlist", "artist", "track", "album"]
                response_variable: ma_search_broad
              - variables:
                  broad_uri: >-
                    {% set r = ma_search_broad if ma_search_broad is defined else {} %}
                    {% set ns = namespace(uri='') %}
                    {% for b in ['playlists', 'tracks', 'artists', 'albums'] %}
                      {% if ns.uri == '' and (r[b] | default([]) | length > 0) %}
                        {% set ns.uri = r[b][0].uri | default('') %}
                      {% endif %}
                    {% endfor %}
                    {{ ns.uri }}
                  broad_label: >-
                    {% set r = ma_search_broad if ma_search_broad is defined else {} %}
                    {% set ns = namespace(label='') %}
                    {% for b in ['playlists', 'tracks', 'artists', 'albums'] %}
                      {% if ns.label == '' and (r[b] | default([]) | length > 0) %}
                        {% set ns.label = r[b][0].name | default('') %}
                      {% endif %}
                    {% endfor %}
                    {{ ns.label }}
                  play_uri: >-
                    {% set u = broad_uri | default('') | trim %}
                    {{ u if u != '' else default_uri }}
                  last_pick_msg: >-
                    {% set u = broad_uri | default('') | trim %}
                    {% if u != '' %}
                      broad: {{ broad_label }} ({{ u }})
                    {% else %}
                      fallback default playlist (no MA match)
                    {% endif %}
              - action: music_assistant.play_media
                target:
                  entity_id: "{{ target_player }}"
                data:
                  media_id: "{{ play_uri }}"
              - action: input_text.set_value
                target:
                  entity_id: input_text.studio_music_last_pick
                data:
                  value: "{{ last_pick_msg[:255] }}"

  set_studio_volume:
    alias: Set Studio Volume
    description: >-
      Set or nudge the Full Studio Music Assistant group volume. Use this for
      any request to set, raise, or lower the music / studio volume. Pass volume
      as 0–100 for an absolute level, or direction as up/down.
    fields:
      volume:
        description: Absolute volume percent 0–100
        example: 70
        selector:
          number:
            min: 0
            max: 100
            step: 1
            unit_of_measurement: "%"
      direction:
        description: Relative change — up or down (ignored when volume is set)
        example: up
        selector:
          select:
            options:
              - up
              - down
    mode: restart
    sequence:
      - variables:
          target_player: media_player.full_studio
          vol_raw: "{{ volume | default(none) }}"
          dir: "{{ direction | default('', true) | string | lower | trim }}"
      - choose:
          - conditions:
              - condition: template
                value_template: >-
                  {{ vol_raw is not none and vol_raw | string | lower not in
                     ['', 'none', 'unknown', 'unavailable']
                     and (vol_raw is number or vol_raw | string | is_number) }}
            sequence:
              - service: media_player.volume_set
                target:
                  entity_id: "{{ target_player }}"
                data:
                  volume_level: >-
                    {{ ([0, [1, (vol_raw | float) / 100] | min] | max) | round(3) }}
          - conditions:
              - condition: template
                value_template: "{{ dir in ['up', 'louder', 'higher'] }}"
            sequence:
              - service: media_player.volume_up
                target:
                  entity_id: "{{ target_player }}"
          - conditions:
              - condition: template
                value_template: "{{ dir in ['down', 'quieter', 'softer', 'lower'] }}"
            sequence:
              - service: media_player.volume_down
                target:
                  entity_id: "{{ target_player }}"

intent_script:
  PlayStudioMusic:
    speech:
      text: >-
        {% set q = query | default('', true) | string | trim %}
        {% set ql = q | lower %}
        {% set wc = q.split() | length %}
        {% set markers = [
          'like', 'fitting', 'mood', 'vibe', 'feel', 'inspirational', 'chill',
          'morning', 'evening', 'for the', 'something', 'time of', 'rainy', 'sunny'
        ] %}
        {% set vibe = (wc > 3 and (markers | select('in', ql) | list | length > 0)) or wc > 5 %}
        {%- if q == '' or ql in ['music','some music','tunes','some tunes','something','songs','some songs','my music','a song','anything','tune'] -%}
        Playing music in the studio.
        {%- elif vibe -%}
        Picking something that fits.
        {%- else -%}
        Playing {{ q }} in the studio.
        {%- endif -%}
    action:
      - service: script.play_studio_music
        data:
          query: "{{ query | default('', true) }}"

  SetStudioVolume:
    description: Set Full Studio music volume to a percent
    action:
      - service: script.set_studio_volume
        data:
          volume: "{{ volume }}"
    speech:
      text: "Okay, Full Studio volume set to {{ volume }}."

  StudioVolumeUp:
    description: Turn Full Studio music volume up
    action:
      - service: script.set_studio_volume
        data:
          direction: up
    speech:
      text: "Okay, turning the music up."

  StudioVolumeDown:
    description: Turn Full Studio music volume down
    action:
      - service: script.set_studio_volume
        data:
          direction: down
    speech:
      text: "Okay, turning the music down."
